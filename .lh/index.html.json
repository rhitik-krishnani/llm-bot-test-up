            "date": 1779291496774,
            "name": "Commit-0",
            "content": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"UTF-8\" />\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\r\n\r\n<title>UPGB AI Credit Assistant</title>\r\n\r\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\r\n\r\n<link rel=\"stylesheet\"\r\nhref=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css\"\r\n/>\r\n\r\n<style>\r\n\r\n/* =========================================================\r\n   RESET\r\n========================================================= */\r\n\r\n*{\r\n    margin:0;\r\n    padding:0;\r\n    box-sizing:border-box;\r\n}\r\n\r\n:root{\r\n    --primary:#146551;\r\n    --primary-dark:#0b3b2f;\r\n    --bg:#f5f8f9;\r\n    --card:#ffffff;\r\n    --border:#dfe7e5;\r\n    --text:#172b28;\r\n    --muted:#6c7f7a;\r\n    --success:#0ea76b;\r\n}\r\n\r\nbody{\r\n    font-family:'Inter',sans-serif;\r\n    background:\r\n    radial-gradient(circle at top left,#1f8d6e 0%,transparent 35%),\r\n    linear-gradient(135deg,#04231d,#146551);\r\n    min-height:100vh;\r\n    display:flex;\r\n    justify-content:center;\r\n    align-items:center;\r\n    padding:16px;\r\n    color:var(--text);\r\n}\r\n\r\n/* =========================================================\r\n   APP\r\n========================================================= */\r\n\r\n.app{\r\n    width:100%;\r\n    max-width:1050px;\r\n    height:95vh;\r\n    background:rgba(255,255,255,.96);\r\n    backdrop-filter:blur(12px);\r\n    border-radius:28px;\r\n    overflow:hidden;\r\n    display:flex;\r\n    flex-direction:column;\r\n    box-shadow:\r\n    0 30px 80px rgba(0,0,0,.25),\r\n    inset 0 1px 0 rgba(255,255,255,.2);\r\n}\r\n\r\n/* =========================================================\r\n   HEADER\r\n========================================================= */\r\n\r\n.header{\r\n    background:\r\n    linear-gradient(\r\n    135deg,\r\n    rgba(8,43,35,.96),\r\n    rgba(20,101,81,.96)\r\n    );\r\n\r\n    color:#fff;\r\n\r\n    padding:22px 24px;\r\n\r\n    display:flex;\r\n    justify-content:space-between;\r\n    align-items:center;\r\n    gap:18px;\r\n\r\n    border-bottom:1px solid rgba(255,255,255,.08);\r\n}\r\n\r\n.title h1{\r\n    display:flex;\r\n    align-items:center;\r\n    gap:12px;\r\n    font-size:1.25rem;\r\n    font-weight:700;\r\n}\r\n\r\n.title p{\r\n    margin-top:6px;\r\n    font-size:.78rem;\r\n    opacity:.88;\r\n    letter-spacing:.2px;\r\n}\r\n\r\n.badges{\r\n    display:flex;\r\n    gap:10px;\r\n    flex-wrap:wrap;\r\n}\r\n\r\n.badge{\r\n    background:rgba(255,255,255,.12);\r\n    border:1px solid rgba(255,255,255,.12);\r\n    padding:9px 14px;\r\n    border-radius:999px;\r\n    font-size:.72rem;\r\n    backdrop-filter:blur(6px);\r\n}\r\n\r\n/* =========================================================\r\n   STATUS BAR\r\n========================================================= */\r\n\r\n.status-bar{\r\n    background:#edf7f3;\r\n    border-bottom:1px solid #dcece5;\r\n    padding:11px 18px;\r\n    display:flex;\r\n    justify-content:space-between;\r\n    align-items:center;\r\n    font-size:.82rem;\r\n    color:#145341;\r\n}\r\n\r\n.live-engine{\r\n    display:flex;\r\n    align-items:center;\r\n    gap:8px;\r\n    font-size:.75rem;\r\n    color:#53776d;\r\n}\r\n\r\n.live-dot{\r\n    width:8px;\r\n    height:8px;\r\n    border-radius:50%;\r\n    background:var(--success);\r\n    box-shadow:0 0 10px rgba(14,167,107,.7);\r\n}\r\n\r\n/* =========================================================\r\n   CHAT\r\n========================================================= */\r\n\r\n.chat{\r\n    flex:1;\r\n    overflow-y:auto;\r\n    padding:24px;\r\n    background:\r\n    linear-gradient(to bottom,#f8fbfa,#f3f7f6);\r\n\r\n    display:flex;\r\n    flex-direction:column;\r\n    gap:18px;\r\n}\r\n\r\n.chat::-webkit-scrollbar{\r\n    width:8px;\r\n}\r\n\r\n.chat::-webkit-scrollbar-thumb{\r\n    background:#d4dfdc;\r\n    border-radius:999px;\r\n}\r\n\r\n/* =========================================================\r\n   MESSAGE\r\n========================================================= */\r\n\r\n.msg{\r\n    max-width:88%;\r\n    display:flex;\r\n    gap:12px;\r\n    animation:fadeUp .25s ease;\r\n}\r\n\r\n.msg.user{\r\n    align-self:flex-end;\r\n    flex-direction:row-reverse;\r\n}\r\n\r\n.avatar{\r\n    width:44px;\r\n    height:44px;\r\n    border-radius:50%;\r\n    display:flex;\r\n    align-items:center;\r\n    justify-content:center;\r\n    flex-shrink:0;\r\n    font-size:1rem;\r\n}\r\n\r\n.bot .avatar{\r\n    background:linear-gradient(135deg,#146551,#0f4d3e);\r\n    color:#fff;\r\n}\r\n\r\n.user .avatar{\r\n    background:#d9e8e2;\r\n    color:#123d32;\r\n}\r\n\r\n.bubble{\r\n    background:#fff;\r\n    border-radius:22px;\r\n    padding:16px 18px;\r\n    line-height:1.7;\r\n    font-size:.93rem;\r\n    box-shadow:\r\n    0 4px 14px rgba(0,0,0,.05);\r\n\r\n    border:1px solid rgba(0,0,0,.03);\r\n}\r\n\r\n.user .bubble{\r\n    background:\r\n    linear-gradient(135deg,#0e5544,#0b3b2f);\r\n\r\n    color:#fff;\r\n}\r\n\r\n/* =========================================================\r\n   PROVIDER TAG\r\n========================================================= */\r\n\r\n.provider-tag{\r\n    display:inline-flex;\r\n    align-items:center;\r\n    gap:7px;\r\n\r\n    padding:5px 10px;\r\n\r\n    border-radius:999px;\r\n\r\n    background:#eef7f2;\r\n    color:#146551;\r\n\r\n    font-size:.7rem;\r\n    font-weight:600;\r\n\r\n    margin-bottom:10px;\r\n}\r\n\r\n.provider-live{\r\n    display:inline-flex;\r\n    align-items:center;\r\n    gap:8px;\r\n\r\n    font-size:.74rem;\r\n    color:#6c7f7a;\r\n}\r\n\r\n.provider-live .pulse{\r\n    width:8px;\r\n    height:8px;\r\n    border-radius:50%;\r\n    background:#0ea76b;\r\n    animation:pulse 1.2s infinite;\r\n}\r\n\r\n/* =========================================================\r\n   NOTICE\r\n========================================================= */\r\n\r\n.notice{\r\n    margin-top:14px;\r\n    background:#eef7f2;\r\n    border-left:4px solid var(--primary);\r\n    padding:12px 14px;\r\n    border-radius:10px;\r\n    font-size:.84rem;\r\n}\r\n\r\n/* =========================================================\r\n   QUICK BUTTONS\r\n========================================================= */\r\n\r\n.quick{\r\n    display:flex;\r\n    gap:10px;\r\n    overflow-x:auto;\r\n    padding:14px 16px;\r\n    border-top:1px solid #edf0ef;\r\n    background:#fbfcfc;\r\n}\r\n\r\n.quick::-webkit-scrollbar{\r\n    display:none;\r\n}\r\n\r\n.quick button{\r\n    white-space:nowrap;\r\n    border:none;\r\n\r\n    background:#e7f0ec;\r\n    color:#145341;\r\n\r\n    padding:11px 15px;\r\n    border-radius:999px;\r\n\r\n    cursor:pointer;\r\n\r\n    font-size:.78rem;\r\n    font-weight:500;\r\n\r\n    transition:.22s;\r\n}\r\n\r\n.quick button:hover{\r\n    background:#d7ebe3;\r\n    transform:translateY(-1px);\r\n}\r\n\r\n/* =========================================================\r\n   INPUT AREA\r\n========================================================= */\r\n\r\n.input-area{\r\n    padding:16px;\r\n    border-top:1px solid #edf0ef;\r\n    display:flex;\r\n    gap:12px;\r\n    background:#fff;\r\n}\r\n\r\n.input-wrapper{\r\n    flex:1;\r\n    position:relative;\r\n}\r\n\r\n.input-area input{\r\n    width:100%;\r\n    padding:16px 18px;\r\n    border-radius:999px;\r\n    border:1px solid #d5e0dd;\r\n    outline:none;\r\n    font-size:.94rem;\r\n    transition:.2s;\r\n}\r\n\r\n.input-area input:focus{\r\n    border-color:#146551;\r\n    box-shadow:0 0 0 4px rgba(20,101,81,.1);\r\n}\r\n\r\n.send-btn{\r\n    width:56px;\r\n    border:none;\r\n    border-radius:50%;\r\n    background:\r\n    linear-gradient(135deg,#146551,#0c4c3d);\r\n\r\n    color:#fff;\r\n    font-size:1rem;\r\n    cursor:pointer;\r\n    transition:.22s;\r\n}\r\n\r\n.send-btn:hover{\r\n    transform:translateY(-2px);\r\n}\r\n\r\n/* =========================================================\r\n   TYPING\r\n========================================================= */\r\n\r\n.typing{\r\n    display:flex;\r\n    align-items:center;\r\n    gap:5px;\r\n}\r\n\r\n.typing span{\r\n    width:8px;\r\n    height:8px;\r\n    border-radius:50%;\r\n    background:#7f968f;\r\n    animation:blink 1.2s infinite;\r\n}\r\n\r\n.typing span:nth-child(2){\r\n    animation-delay:.2s;\r\n}\r\n\r\n.typing span:nth-child(3){\r\n    animation-delay:.4s;\r\n}\r\n\r\n/* =========================================================\r\n   ANIMATIONS\r\n========================================================= */\r\n\r\n@keyframes blink{\r\n    0%,100%{\r\n        opacity:.35;\r\n        transform:translateY(0);\r\n    }\r\n\r\n    50%{\r\n        opacity:1;\r\n        transform:translateY(-4px);\r\n    }\r\n}\r\n\r\n@keyframes fadeUp{\r\n    from{\r\n        opacity:0;\r\n        transform:translateY(10px);\r\n    }\r\n\r\n    to{\r\n        opacity:1;\r\n        transform:translateY(0);\r\n    }\r\n}\r\n\r\n@keyframes pulse{\r\n    0%{\r\n        transform:scale(1);\r\n        opacity:1;\r\n    }\r\n\r\n    50%{\r\n        transform:scale(1.4);\r\n        opacity:.5;\r\n    }\r\n\r\n    100%{\r\n        transform:scale(1);\r\n        opacity:1;\r\n    }\r\n}\r\n\r\n/* =========================================================\r\n   MOBILE\r\n========================================================= */\r\n\r\n@media(max-width:700px){\r\n\r\n    body{\r\n        padding:0;\r\n    }\r\n\r\n    .app{\r\n        height:100vh;\r\n        border-radius:0;\r\n    }\r\n\r\n    .header{\r\n        flex-direction:column;\r\n        align-items:flex-start;\r\n    }\r\n\r\n    .status-bar{\r\n        flex-direction:column;\r\n        align-items:flex-start;\r\n        gap:6px;\r\n    }\r\n\r\n    .msg{\r\n        max-width:96%;\r\n    }\r\n}\r\n\r\n</style>\r\n</head>\r\n\r\n<body>\r\n\r\n<div class=\"app\">\r\n\r\n    <!-- HEADER -->\r\n\r\n    <div class=\"header\">\r\n\r\n        <div class=\"title\">\r\n\r\n            <h1>\r\n                <i class=\"fas fa-robot\"></i>\r\n                UPGB AI Credit Assistant\r\n            </h1>\r\n\r\n            <p>\r\n                Intelligent Credit Assistant • Groq + OpenRouter Failover\r\n            </p>\r\n\r\n        </div>\r\n\r\n        <div class=\"badges\">\r\n\r\n            <div class=\"badge\">\r\n                🏦 25+ Loan Products\r\n            </div>\r\n\r\n            <div class=\"badge\">\r\n                📊 CIBIL Analysis\r\n            </div>\r\n\r\n            <div class=\"badge\">\r\n                ⚡ AI Failover Engine\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- STATUS -->\r\n\r\n    <div class=\"status-bar\">\r\n\r\n        <div>\r\n            <i class=\"fas fa-shield-alt\"></i>\r\n            Secure Backend Mode Enabled\r\n        </div>\r\n\r\n        <div class=\"live-engine\">\r\n            <div class=\"live-dot\"></div>\r\n            Active AI Routing Enabled\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- CHAT -->\r\n\r\n    <div class=\"chat\" id=\"chat\">\r\n\r\n        <div class=\"msg bot\">\r\n\r\n            <div class=\"avatar\">\r\n                <i class=\"fas fa-robot\"></i>\r\n            </div>\r\n\r\n            <div class=\"bubble\">\r\n\r\n                <strong>नमस्ते 👋</strong>\r\n\r\n                <br><br>\r\n\r\n                मैं UPGB AI Credit Assistant हूँ।\r\n\r\n                <br><br>\r\n\r\n                आप पूछ सकते हैं:\r\n\r\n                <ul style=\"margin-left:18px;margin-top:10px\">\r\n                    <li>Mera CIBIL 745 hai</li>\r\n                    <li>Housing loan ROI kya hai?</li>\r\n                    <li>KCC renewal documents</li>\r\n                    <li>Private employee bike loan</li>\r\n                </ul>\r\n\r\n                <div class=\"notice\">\r\n                    Smart AI fallback active for uninterrupted response handling.\r\n                </div>\r\n\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <!-- QUICK ACTIONS -->\r\n\r\n    <div class=\"quick\">\r\n\r\n        <button onclick=\"quickAsk('Mera CIBIL 750 hai')\">\r\n            📊 CIBIL 750\r\n        </button>\r\n\r\n        <button onclick=\"quickAsk('Housing loan ROI')\">\r\n            🏠 Housing Loan\r\n        </button>\r\n\r\n        <button onclick=\"quickAsk('KCC renewal documents')\">\r\n            🌾 KCC Renewal\r\n        </button>\r\n\r\n        <button onclick=\"quickAsk('Two wheeler private employee')\">\r\n            🏍️ Bike Loan\r\n        </button>\r\n\r\n        <button onclick=\"quickAsk('All loan list')\">\r\n            📋 All Loans\r\n        </button>\r\n\r\n    </div>\r\n\r\n    <!-- INPUT -->\r\n\r\n    <div class=\"input-area\">\r\n\r\n        <div class=\"input-wrapper\">\r\n\r\n            <input\r\n            type=\"text\"\r\n            id=\"prompt\"\r\n            placeholder=\"अपना सवाल लिखें...\"\r\n            />\r\n\r\n        </div>\r\n\r\n        <button class=\"send-btn\" onclick=\"sendMessage()\">\r\n            <i class=\"fas fa-paper-plane\"></i>\r\n        </button>\r\n\r\n    </div>\r\n\r\n</div>\r\n\r\n<script>\r\n\r\n/* =========================================================\r\n   IMPORTANT\r\n========================================================= */\r\n\r\n/*\r\nDO NOT PUT API KEYS HERE\r\n\r\nVercel Environment Variables:\r\n\r\nGROQ_API_KEY\r\nOPENROUTER_API_KEY\r\n\r\nThese will be used through backend API routes.\r\n*/\r\n\r\n\r\n/* =========================================================\r\n   MODELS\r\n========================================================= */\r\n\r\nconst GROQ_MODEL = \"llama-3.3-70b-versatile\";\r\n\r\nconst OPENROUTER_MODEL = \"qwen/qwen-2.5-72b-instruct\";\r\n\r\n\r\n/* =========================================================\r\n   SYSTEM PROMPT\r\n========================================================= */\r\n\r\nconst SYSTEM_PROMPT = `\r\nYou are UPGB (Uttar Pradesh Gramin Bank) Smart Credit Assistant.\r\n\r\nRules:\r\n- Reply in Hindi + English mix.\r\n- Be concise but professional.\r\n- Use HTML formatting.\r\n- Only answer banking, loan, CIBIL, MSME, KCC and UPGB related queries.\r\n- If unrelated, politely refuse by saying exactly:\r\nThis question is out of my scope, kindly ask questions related to banking, loan, CIBIL, MSME, KCC and UPGB related queries only.\r\n\r\nMinimum CIBIL: 675\r\n\r\nHousing Loan ROI:\r\n800+ = 7.20%\r\n751-799 = 7.45%\r\n726-750 = 7.85%\r\n701-725 = 8.05%\r\n675-700 = 9.05%\r\n\r\nCar Loan ROI:\r\n800+ = 7.60%\r\n751-799 = 7.85%\r\n726-750 = 8.40%\r\n701-725 = 9.15%\r\n675-700 = 10.50%\r\n\r\nTwo Wheeler Loan:\r\nOnly Govt/PSU employees eligible.\r\nPrivate employees NOT eligible.\r\n\r\nKCC:\r\nNo CIBIL required.\r\n`;\r\n\r\n\r\n/* =========================================================\r\n   CHAT UI\r\n========================================================= */\r\n\r\nconst chat = document.getElementById(\"chat\");\r\n\r\nfunction addMessage(text, type=\"bot\"){\r\n\r\n    const div = document.createElement(\"div\");\r\n\r\n    div.className = `msg ${type}`;\r\n\r\n    div.innerHTML = `\r\n        <div class=\"avatar\">\r\n            <i class=\"fas fa-${type === 'bot' ? 'robot' : 'user'}\"></i>\r\n        </div>\r\n\r\n        <div class=\"bubble\">\r\n            ${text}\r\n        </div>\r\n    `;\r\n\r\n    chat.appendChild(div);\r\n\r\n    chat.scrollTop = chat.scrollHeight;\r\n}\r\n\r\nfunction quickAsk(text){\r\n\r\n    document.getElementById(\"prompt\").value = text;\r\n\r\n    sendMessage();\r\n}\r\n\r\nfunction showTyping(provider = \"Routing Request\"){\r\n\r\n    const div = document.createElement(\"div\");\r\n\r\n    div.className = \"msg bot\";\r\n\r\n    div.id = \"typing\";\r\n\r\n    div.innerHTML = `\r\n        <div class=\"avatar\">\r\n            <i class=\"fas fa-robot\"></i>\r\n        </div>\r\n\r\n        <div class=\"bubble\">\r\n\r\n            <div class=\"provider-live\">\r\n                <div class=\"pulse\"></div>\r\n                ${provider}\r\n            </div>\r\n\r\n            <br>\r\n\r\n            <div class=\"typing\">\r\n                <span></span>\r\n                <span></span>\r\n                <span></span>\r\n            </div>\r\n\r\n        </div>\r\n    `;\r\n\r\n    chat.appendChild(div);\r\n\r\n    chat.scrollTop = chat.scrollHeight;\r\n}\r\n\r\nfunction updateTypingProvider(provider){\r\n\r\n    const typing = document.getElementById(\"typing\");\r\n\r\n    if(!typing) return;\r\n\r\n    const label = typing.querySelector(\".provider-live\");\r\n\r\n    if(label){\r\n\r\n        label.innerHTML = `\r\n            <div class=\"pulse\"></div>\r\n            Generating via ${provider}\r\n        `;\r\n    }\r\n}\r\n\r\nfunction removeTyping(){\r\n\r\n    const el = document.getElementById(\"typing\");\r\n\r\n    if(el){\r\n        el.remove();\r\n    }\r\n}\r\n\r\n\r\n/* =========================================================\r\n   BACKEND API CALL\r\n========================================================= */\r\n\r\nasync function getAIResponse(message){\r\n\r\n    updateTypingProvider(\"Groq\");\r\n\r\n    const response = await fetch(\"/api/chat\",{\r\n\r\n        method:\"POST\",\r\n\r\n        headers:{\r\n            \"Content-Type\":\"application/json\"\r\n        },\r\n\r\n        body:JSON.stringify({\r\n            message\r\n        })\r\n\r\n    });\r\n\r\n    if(!response.ok){\r\n\r\n        throw new Error(\"AI server unavailable\");\r\n    }\r\n\r\n    return await response.json();\r\n}\r\n\r\n\r\n/* =========================================================\r\n   SEND MESSAGE\r\n========================================================= */\r\n\r\nasync function sendMessage(){\r\n\r\n    const input = document.getElementById(\"prompt\");\r\n\r\n    const message = input.value.trim();\r\n\r\n    if(!message){\r\n        return;\r\n    }\r\n\r\n    addMessage(message,\"user\");\r\n\r\n    input.value = \"\";\r\n\r\n    showTyping();\r\n\r\n    try{\r\n\r\n        const result = await getAIResponse(message);\r\n\r\n        removeTyping();\r\n\r\n        addMessage(`\r\n\r\n            <div class=\"provider-tag\">\r\n                <i class=\"fas fa-microchip\"></i>\r\n                ${result.provider}\r\n            </div>\r\n\r\n            ${result.text.replace(/\\n/g,\"<br>\")}\r\n\r\n        `);\r\n\r\n    }catch(err){\r\n\r\n        removeTyping();\r\n\r\n        addMessage(`\r\n            ❌ Unable to process request currently.\r\n            <br><br>\r\n            ${err.message}\r\n        `);\r\n\r\n        console.error(err);\r\n    }\r\n}\r\n\r\n\r\n/* =========================================================\r\n   ENTER KEY\r\n========================================================= */\r\n\r\ndocument\r\n.getElementById(\"prompt\")\r\n.addEventListener(\"keypress\",function(e){\r\n\r\n    if(e.key === \"Enter\"){\r\n        sendMessage();\r\n    }\r\n\r\n});\r\n\r\n</script>\r\n\r\n</body>\r\n</html>"
        }
    ]
}